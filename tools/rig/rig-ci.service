[Unit]
Description=Trust Issues rig CI: test the newest master commit on the rig

[Service]
Type=oneshot
# the clone of the repository that holds this script; update it with git pull (the tests themselves run from a fresh worktree)
WorkingDirectory=%h/TrustIssue
ExecStart=/usr/bin/flock -n %h/.local/state/trustissue-rig/lock /usr/bin/python3 tools/build/rig_ci.py --once
TimeoutStartSec=3h
