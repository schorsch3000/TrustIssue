[Unit]
Description=Trust Issue rig CI: test the newest master commit on the rig

[Service]
Type=oneshot
# the clone of the repository that holds this script; update it with git pull (the tests themselves run from a fresh worktree)
WorkingDirectory=%h/TrustIssue
ExecStart=/usr/bin/python3 tools/build/rig_ci.py --once
TimeoutStartSec=3h
# SIGTERM at the timeout: rig_ci.py then switches the rig off itself
KillSignal=SIGTERM
